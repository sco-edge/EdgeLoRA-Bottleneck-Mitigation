+// Build ACC nodes out of place, then opt in to aliasing only after the complete
+// graph has exposed every consumer of each pre-update value.
+struct llm_lora_acc_candidate {
+    ggml_tensor * before;
+    ggml_tensor * delta;
+    ggml_tensor * after;
