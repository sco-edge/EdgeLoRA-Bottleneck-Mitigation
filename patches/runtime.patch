+static void write_u32(std::ofstream & out, uint32_t value) {
+    const unsigned char bytes[4] = {
+        static_cast<unsigned char>(value), static_cast<unsigned char>(value >> 8),
+        static_cast<unsigned char>(value >> 16), static_cast<unsigned char>(value >> 24),
+    };
+    out.write(reinterpret_cast<const char *>(bytes), sizeof(bytes));
+}
+
+static void write_classifier(const std::string & path, const char magic[8], uint32_t dtype,
+                             uint32_t labels, uint32_t hidden, const std::vector<float> & weights) {
+    std::ofstream out(path, std::ios::binary);
+    out.write(magic, 8);
+    write_u32(out, 1);
+    write_u32(out, dtype);
+    write_u32(out, labels);
+    write_u32(out, hidden);
+    for (float value : weights) {
+        uint32_t bits;
+        std::memcpy(&bits, &value, sizeof(bits));
+        write_u32(out, bits);
+    }
+}
+
