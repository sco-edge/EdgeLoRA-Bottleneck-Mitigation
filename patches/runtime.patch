+static thread_local std::vector<llm_lora_acc_candidate> llm_lora_acc_candidates;
+
+static bool llm_lora_acc_auto_enabled() {
+    static const bool enabled = []() {
+        const char * value = getenv("EDGELORA_ACC_AUTO");
+        return value != nullptr && strcmp(value, "1") == 0;
+    }();
+    return enabled;
