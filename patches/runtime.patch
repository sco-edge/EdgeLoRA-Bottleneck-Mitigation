+    assert(!router_classifier_load(path, classifier, error)); // invalid dimensions
+    write_classifier(path, magic, 1, 2, 3072, std::vector<float>(1));
+    assert(!router_classifier_load(path, classifier, error)); // valid header, invalid file size
+    valid_weights[100] = std::numeric_limits<float>::infinity();
+    write_classifier(path, magic, 1, 2, 3072, valid_weights);
+    assert(!router_classifier_load(path, classifier, error));
+    std::remove(path.c_str());
+    // Actual six-label storage and deterministic ranking, including cache fallback.
+    std::vector<float> six_weights(6 * 3072, 0.0f);
+    for (size_t label = 0; label < 6; ++label) { six_weights[label * 3072] = float(label); }
+    write_classifier(path, magic, 1, 6, 3072, six_weights);
+    assert(router_classifier_load(path, classifier, error));
+    std::vector<float> six_hidden(3072, 0.0f);
+    six_hidden[0] = 1.0f;
+    const auto six_scores = router_classifier_score(classifier, six_hidden.data(), 3072);
+    assert((router_rank_labels(six_scores) == std::vector<int32_t>{5,4,3,2,1,0}));
+    assert(router_select_adapter({5,4}, {0,1,2,3,4,5}, 6,
+                                 {false,false,false,false,true,false,true}, cache_hit) == 4);
+    assert(cache_hit);
+    assert(router_select_adapter({5}, {0,1,2,3,4,5}, 6,
+                                 {false,false,false,false,true,false,true}, cache_hit) == 5);
+    assert(!cache_hit);
+    six_hidden[0] = std::numeric_limits<float>::infinity();
+    assert(router_classifier_score(classifier, six_hidden.data(), 3072).empty());
+    write_classifier(path, magic, 1, 7, 3072, std::vector<float>(7 * 3072));
+    assert(!router_classifier_load(path, classifier, error));
+    std::remove(path.c_str());
+    return 0;
+}
