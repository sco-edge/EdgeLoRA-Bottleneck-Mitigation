+                return reject("unrecognized predecessor");
+            }
+        }
+    }
+
+    // All candidates passed. They form a chain, so convert in build order.
+    for (const auto & candidate : llm_lora_acc_candidates) {
+        auto * before = candidate.before;
+        auto * after = candidate.after;
+        auto * storage = before->view_src ? before->view_src : before;
+        after->view_src = storage;
+        after->view_offs = before->view_offs;
+        after->data = before->data;
+        after->buffer = before->buffer;
+        int32_t params[5];
+        memcpy(params, after->op_params, sizeof(params));
