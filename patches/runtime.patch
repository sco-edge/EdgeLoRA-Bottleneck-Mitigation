diff --git a/edgelora/common/router-classifier.cpp b/edgelora/common/router-classifier.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8418a54ebd986b91ffb7eb39808b7b474f9b31c7
--- /dev/null
+++ b/edgelora/common/router-classifier.cpp
@@ -0,0 +1,174 @@
+#include "router-classifier.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <fstream>
+#include <limits>
+#include <numeric>
+
+namespace {
+constexpr char ROUTER_MAGIC[8] = {'E', 'L', 'R', 'T', 'R', 'S', 'C', 'R'};
+constexpr uint32_t ROUTER_VERSION = 1;
+constexpr uint32_t ROUTER_DTYPE_F32 = 1;
+// Keep the original two-label fixture, and support the frozen six-task Router.
+constexpr uint32_t ROUTER_HIDDEN_SIZE = 3072;
+constexpr size_t ROUTER_HEADER_SIZE = 8 + 4 * sizeof(uint32_t);
+
+bool read_u32_le(std::istream & input, uint32_t & value) {
+    unsigned char bytes[4];
+    if (!input.read(reinterpret_cast<char *>(bytes), sizeof(bytes))) {
+        return false;
+    }
+    value = uint32_t(bytes[0]) | (uint32_t(bytes[1]) << 8) |
+            (uint32_t(bytes[2]) << 16) | (uint32_t(bytes[3]) << 24);
+    return true;
+}
+}
+
+bool router_classifier_load(const std::string & path, router_classifier & classifier, std::string & error) {
+    classifier = {};
+    std::ifstream input(path, std::ios::binary | std::ios::ate);
+    if (!input) {
+        error = "cannot open classifier: " + path;
+        return false;
+    }
+    const std::streamoff file_size = input.tellg();
+    input.seekg(0);
+    char magic[sizeof(ROUTER_MAGIC)];
+    uint32_t version, dtype, num_labels, hidden_size;
+    if (!input.read(magic, sizeof(magic)) || !read_u32_le(input, version) ||
+        !read_u32_le(input, dtype) || !read_u32_le(input, num_labels) ||
+        !read_u32_le(input, hidden_size)) {
+        error = "truncated classifier header";
+        return false;
+    }
+    if (std::memcmp(magic, ROUTER_MAGIC, sizeof(magic)) != 0) {
+        error = "invalid classifier magic";
+        return false;
+    }
+    if (version != ROUTER_VERSION) {
+        error = "unsupported classifier version";
+        return false;
+    }
+    if (dtype != ROUTER_DTYPE_F32) {
+        error = "unsupported classifier dtype";
+        return false;
+    }
+    if ((num_labels != 2 && num_labels != 6) || hidden_size != ROUTER_HIDDEN_SIZE ||
+        size_t(num_labels) > std::numeric_limits<size_t>::max() / size_t(hidden_size)) {
+        error = "invalid classifier dimensions";
+        return false;
+    }
+    const size_t count = size_t(num_labels) * size_t(hidden_size);
+    const size_t expected_size = ROUTER_HEADER_SIZE + count * sizeof(float);
+    if (file_size < 0 || size_t(file_size) != expected_size) {
+        error = "classifier file size does not match dimensions";
+        return false;
+    }
+    classifier.num_labels = num_labels;
+    classifier.hidden_size = hidden_size;
+    classifier.weights.resize(count);
+    for (size_t i = 0; i < count; ++i) {
+        uint32_t bits;
+        if (!read_u32_le(input, bits)) {
+            error = "truncated classifier weights";
+            classifier = {};
+            return false;
+        }
+        float value;
+        std::memcpy(&value, &bits, sizeof(value));
+        if (!std::isfinite(value)) {
+            error = "classifier contains non-finite weight";
+            classifier = {};
+            return false;
+        }
+        classifier.weights[i] = value;
+    }
+    return true;
+}
+
+std::vector<float> router_classifier_score(const router_classifier & classifier, const float * hidden, size_t hidden_size) {
+    if (hidden == nullptr || hidden_size != classifier.hidden_size) {
+        return {};
+    }
+    std::vector<float> scores(classifier.num_labels, 0.0f);
+    for (size_t label = 0; label < classifier.num_labels; ++label) {
+        const float * row = classifier.weights.data() + label * classifier.hidden_size;
+        float score = 0.0f;
+        for (size_t i = 0; i < classifier.hidden_size; ++i) {
+            score += row[i] * hidden[i];
+        }
+        if (!std::isfinite(score)) { return {}; }
+        scores[label] = score;
+    }
+    return scores;
+}
+
+std::vector<int32_t> router_rank_labels(const std::vector<float> & scores) {
+    std::vector<int32_t> labels(scores.size());
+    std::iota(labels.begin(), labels.end(), 0);
+    std::stable_sort(labels.begin(), labels.end(), [&scores](int32_t a, int32_t b) {
+        return scores[a] > scores[b];
+    });
+    return labels;
+}
+
+bool router_top_k_valid(int32_t top_k, size_t num_labels) {
+    return top_k >= 1 && size_t(top_k) <= num_labels;
+}
+
+std::vector<int32_t> router_top_candidates(
+        const std::vector<int32_t> & ranked_labels,
+        int32_t top_k) {
+    if (!router_top_k_valid(top_k, ranked_labels.size())) {
+        return {};
+    }
+    return {ranked_labels.begin(), ranked_labels.begin() + top_k};
+}
+
+int32_t router_select_adapter(
+        const std::vector<int32_t> & ranked_labels,
+        const std::vector<int32_t> & label_to_adapter,
+        int32_t router_adapter_id,
+        const std::vector<bool> & resident,
+        bool & cache_hit) {
+    cache_hit = false;
+    int32_t top1 = -1;
+    for (int32_t label : ranked_labels) {
+        if (label < 0 || size_t(label) >= label_to_adapter.size()) {
+            return -1;
+        }
+        const int32_t adapter = label_to_adapter[label];
+        if (adapter < 0 || adapter == router_adapter_id) {
+            continue;
+        }
+        if (top1 < 0) {
+            top1 = adapter;
+        }
+        if (size_t(adapter) < resident.size() && resident[adapter]) {
+            cache_hit = true;
+            return adapter;
+        }
+    }
+    return top1;
+}
+
+size_t router_preload_count(int32_t adapter_cache_size, size_t num_lora) {
+    return adapter_cache_size > 0 ? std::min<size_t>(size_t(adapter_cache_size), num_lora) : 0;
+}
+
+bool router_should_route(bool router_enabled, bool explicit_adapter_id, bool embedding_request) {
+    return router_enabled && !explicit_adapter_id && !embedding_request;
+}
+
+std::vector<int32_t> router_task_adapter_ids(size_t num_lora, int32_t router_adapter_id) {
+    std::vector<int32_t> result;
+    result.reserve(num_lora);
+    for (size_t i = 0; i < num_lora; ++i) {
+        if (static_cast<int32_t>(i) != router_adapter_id) {
+            result.push_back(static_cast<int32_t>(i));
+        }
+    }
+    return result;
+}
