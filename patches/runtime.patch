+        return value != nullptr && strcmp(value, "1") == 0;
+    }();
+    auto reject = [&](const char * reason) {
+        if (trace) {
+            fprintf(stderr, "ACC_AUTO fallback: %s (%zu candidates)\n",
+                    reason, llm_lora_acc_candidates.size());
+        }
+        return false;
+    };
+    const char * force_fallback = getenv("EDGELORA_ACC_AUTO_FORCE_FALLBACK");
+    if (force_fallback != nullptr && strcmp(force_fallback, "1") == 0) {
+        return reject("forced fallback diagnostic");
+    }
+
+    std::unordered_set<ggml_tensor *> nodes;
+    std::unordered_set<ggml_tensor *> viewed;
+    std::unordered_map<ggml_tensor *, ggml_tensor *> sole_reader;
+    std::unordered_set<ggml_tensor *> multiply_read;
+    for (int i = 0; i < graph->n_nodes; ++i) {
+        auto * node = graph->nodes[i];
+        nodes.insert(node);
+        if (node->view_src) {
+            viewed.insert(node->view_src);
+        }
+        for (auto * src : node->src) {
+            if (!src) {
+                continue;
+            }
