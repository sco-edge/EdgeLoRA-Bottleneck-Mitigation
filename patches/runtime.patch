+// backend-async: a single loader thread materializes reserved pool objects
+// (GGUF read + backend allocation + H2D copy) while the main thread keeps
+// decoding. The main thread owns every cache/container/slot mutation: it
+// reserves before submit() and publishes after the job is taken back with
+// take_done(). The worker only ever touches the reserved object.
+enum class async_job_phase {
+    QUEUED,
+    RUNNING,
+    DONE,
+};
+
+struct adapter_async_job {
+    uint64_t job_id = 0;
+    int32_t adapter_id = -1;
+    std::string path;
+    llama_lora_reservation reservation;
+    async_job_phase phase = async_job_phase::QUEUED;
+    bool ok = false;
+    bool fail_inject = false;
