+    std::condition_variable cv_worker;
+    std::condition_variable cv_done;
+    std::deque<std::shared_ptr<adapter_async_job>> queue;   // QUEUED, FIFO
+    std::vector<std::shared_ptr<adapter_async_job>> done;   // DONE, awaiting publish
+    std::shared_ptr<adapter_async_job> running;             // RUNNING (at most one)
+    std::thread worker;
+    bool started = false;
+    bool stopping = false;
+    uint64_t next_job_id = 1;
+    llama_model * model = nullptr;
+    std::function<void()> wake_server;
+
+    // main-thread only: adapter_id -> job that is QUEUED/RUNNING/DONE-unpublished
+    std::unordered_map<int32_t, std::shared_ptr<adapter_async_job>> inflight;
