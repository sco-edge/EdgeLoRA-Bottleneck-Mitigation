+    // publish(false) so their reservations go back to the pool.
+    void shutdown() {
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            if (!started) {
+                return;
+            }
+            stopping = true;
+        }
+        cv_worker.notify_all();
+        if (worker.joinable()) {
+            worker.join();
+        }
+        std::lock_guard<std::mutex> lock(mutex);
