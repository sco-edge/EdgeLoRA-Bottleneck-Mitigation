+        }
+    }
+
+    std::unordered_set<ggml_tensor *> candidate_outputs;
+    for (const auto & candidate : llm_lora_acc_candidates) {
+        candidate_outputs.insert(candidate.after);
+    }
+
+    for (const auto & candidate : llm_lora_acc_candidates) {
+        auto * before = candidate.before;
+        auto * after  = candidate.after;
+        int32_t params[5];
+        memcpy(params, after->op_params, sizeof(params));
+        if (!nodes.count(before) || !nodes.count(after) ||
+            after->op != GGML_OP_ACC || after->src[0] != before ||
+            after->src[1] != candidate.delta ||
+            after->view_src != nullptr || after->data != nullptr ||
+            after->buffer != nullptr || after->grad != nullptr ||
+            after->flags != 0 || params[4] != 0 ||
+            before->view_src != nullptr || before->data != nullptr ||
+            before->buffer != nullptr || before->grad != nullptr ||
+            before->flags != 0 || before->type != GGML_TYPE_F32 ||
+            after->type != GGML_TYPE_F32 ||
+            !ggml_is_contiguous(before) || !ggml_is_contiguous(after) ||
+            ggml_nbytes(before) != ggml_nbytes(after) ||
+            viewed.count(before) || multiply_read.count(before) ||
+            sole_reader[before] != after) {
+            return reject("shape, ownership, or liveness check");
+        }
