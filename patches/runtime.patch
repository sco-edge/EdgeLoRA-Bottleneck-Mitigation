diff --git a/edgelora/src/llama-lora-output-map.h b/edgelora/src/llama-lora-output-map.h
new file mode 100644
index 0000000000000000000000000000000000000000..f01b7d78c6126eb055a7acabe9229f4b9726f6f4
--- /dev/null
+++ b/edgelora/src/llama-lora-output-map.h
@@ -0,0 +1,34 @@
+#pragma once
+
+#include <cstdint>
+#include <stdexcept>
+#include <vector>
+
+// Mirror llama_set_inputs' inp_out_ids selection. The output matrix columns
+// and their adapter IDs must undergo exactly the same row selection.
+inline std::vector<int32_t> llama_lora_select_output_adapter_ids(
+        const std::vector<int32_t> & input_ids,
+        const int8_t * output_mask,
+        size_t n_outputs) {
+    if (n_outputs > input_ids.size()) {
+        throw std::invalid_argument("LoRA output count exceeds input count");
+    }
+    if (n_outputs == input_ids.size()) {
+        return input_ids; // includes all-output graph reservation
+    }
+    std::vector<int32_t> result;
+    result.reserve(n_outputs);
+    if (output_mask != nullptr) {
+        for (size_t i = 0; i < input_ids.size(); ++i) {
+            if (output_mask[i]) {
+                result.push_back(input_ids[i]);
+            }
+        }
+    } else if (n_outputs == 1) {
+        result.push_back(input_ids.back());
+    }
+    if (result.size() != n_outputs) {
+        throw std::invalid_argument("LoRA output mask/count mismatch");
+    }
+    return result;
+}
