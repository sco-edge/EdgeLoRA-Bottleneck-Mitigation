+// Fail closed: one unsafe or unrecognized candidate leaves the entire graph
+// in its original, out-of-place form. This runs before scheduler allocation.
+static bool llm_lora_acc_try_inplace(ggml_cgraph * graph) {
+    if (!llm_lora_acc_auto_enabled() || llm_lora_acc_candidates.empty()) {
+        return false;
+    }
+    static const bool trace = []() {
